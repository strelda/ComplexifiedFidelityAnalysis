 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "winding", " ", "numbers", " ", "by", " ", "integrating", 
    " ", "along", " ", "the", " ", "rectangle", " ", "border"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ComputeWindingNumberRect", "[", 
     RowBox[{"min_", ",", "max_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "z0", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"z0", "=", 
        FractionBox[
         RowBox[{"max", "+", "min"}], "2"]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Re", "[", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"2", "\[Pi]", " ", "I"}]], 
         RowBox[{"Quiet", "@", 
          RowBox[{"ContourIntegrate", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ND", "[", 
              RowBox[{
               RowBox[{"Z", "[", "zp", "]"}], ",", "zp", ",", "z", ",", 
               RowBox[{"Scale", "->", "0.001"}], ",", 
               RowBox[{"Terms", "->", "11"}]}], "]"}], "/", 
             RowBox[{"Z", "[", "z", "]"}]}], ",", 
            RowBox[{"z", "\[Element]", 
             RowBox[{"Rectangle", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Re", "@", "min"}], ",", 
                 RowBox[{"Im", "@", "min"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Re", "@", "max"}], ",", 
                 RowBox[{"Im", "@", "max"}]}], "}"}]}], "]"}]}], ",", 
            RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
