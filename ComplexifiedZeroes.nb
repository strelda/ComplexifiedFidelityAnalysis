     RowBox[{"eF", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "-", 
     RowBox[{"eF", "[", 
      RowBox[{"[", "j", "]"}], "]"}]}]], 
   RowBox[{"Log", "[", 
    FractionBox[
     RowBox[{"k", "[", 
      RowBox[{"[", "i", "]"}], "]"}], 
     RowBox[{"k", "[", 
      RowBox[{"[", "j", "]"}], "]"}]], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Beta]PredRadius", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
