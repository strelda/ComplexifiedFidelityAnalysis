Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"eF", "[", 
     RowBox[{"[", "i", "]"}], "]"}], "-", 
    RowBox[{"eF", "[", 
     RowBox[{"[", "j", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"first", " ", "condition"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hood1", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"AllTrue", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"k", "[", 
        RowBox[{"[", "n", "]"}], "]"}], "<", 
       RowBox[{
        RowBox[{"k", "[", 
         RowBox[{"[", "i", "]"}], "]"}], 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"k", "[", 
            RowBox[{"[", "i", "]"}], "]"}], 
           RowBox[{"k", "[", 
            RowBox[{"[", "j", "]"}], "]"}]], ")"}], 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"\[CapitalDelta]", "[", 
            RowBox[{"i", ",", "n"}], "]"}], 
           RowBox[{"\[CapitalDelta]", "[", 
            RowBox[{"i", ",", "j"}], "]"}]]}]]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", 
        RowBox[{"DeleteElements", "[", 
         RowBox[{
          RowBox[{"Range", "[", "dim", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "j"}], "}"}]}], "]"}]}], "}"}]}], "]"}], ",", 
    "TrueQ"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cond2", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         FractionBox[
          RowBox[{"k", "[", 
           RowBox[{"[", "n", "]"}], "]"}], 
          RowBox[{"k", "[", 
           RowBox[{"[", "i", "]"}], "]"}]], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            RowBox[{"k", "[", 
             RowBox[{"[", "i", "]"}], "]"}], 
            RowBox[{"k", "[", 
             RowBox[{"[", "j", "]"}], "]"}]], ")"}], 
          FractionBox[
           RowBox[{"\[CapitalDelta]", "[", 
            RowBox[{"i", ",", "n"}], "]"}], 
           RowBox[{"\[CapitalDelta]", "[", 
            RowBox[{"i", ",", "j"}], "]"}]]]}], "-", "1"}], "]"}], ">", "c"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"DeleteElements", "[", 
        RowBox[{
         RowBox[{"Range", "[", "dim", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "j"}], "}"}]}], "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
