Cell[BoxData[{
 RowBox[{
  RowBox[{"k", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"Conjugate", "[", "psiI", "]"}], ".", 
        RowBox[{"eigvF", "[", 
         RowBox[{"[", "#", "]"}], "]"}]}], "]"}], "2"], "&"}], "/@", 
    RowBox[{"Range", "[", "dim", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Z", "[", 
     RowBox[{"\[Beta]_", ",", "t_"}], "]"}], ":=", " ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"k", "[", 
         RowBox[{"[", "#", "]"}], "]"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"eF", "[", 
            RowBox[{"[", "#", "]"}], "]"}]}], 
          RowBox[{"(", 
