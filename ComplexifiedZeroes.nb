         RowBox[{"k", "[", 
          RowBox[{"[", "#", "]"}], "]"}], "2"], 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"eF", "[", 
           RowBox[{"[", "#", "]"}], "]"}], 
          RowBox[{"\[Beta]Pred", "[", 
           RowBox[{"i", ",", "j"}], "]"}]}], "]"}]}], "&"}], "/@", 
      RowBox[{"Range", "[", "dim", "]"}]}], 
     "]"}]]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tPred", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox["\[Pi]", 
       RowBox[{
        RowBox[{"eF", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "-", 
        RowBox[{"eF", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}]], 
