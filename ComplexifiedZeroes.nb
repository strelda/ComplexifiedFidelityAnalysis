Cell[BoxData[{
 RowBox[{
  RowBox[{"SubdivideRect", "[", 
   RowBox[{"{", 
    RowBox[{"min_", ",", "max_"}], "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "subd", ",", "reMin", ",", "reMax", ",", "imMin", ",", "imMax", ",", 
      "reQuarters", ",", "imQuarters", ",", "subdividedRectangles", ",", 
      "subdividedRectanglesWinding", ",", "selected"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "subdivide", " ", "the", " ", "edge", " ", "of", " ", "square", " ", 
      "into", " ", "subd", " ", "pieces"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"subd", "=", "8"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"reMin", ",", "reMax"}], "}"}], "=", 
      RowBox[{"Re", "[", 
       RowBox[{"{", 
        RowBox[{"min", ",", "max"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"imMin", ",", "imMax"}], "}"}], "=", 
      RowBox[{"Im", "[", 
       RowBox[{"{", 
        RowBox[{"min", ",", "max"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Calculate", " ", "quarter", " ", "points", " ", "along", " ", "real", 
       " ", "and", " ", "imaginary", " ", "axes"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"reQuarters", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"reMin", ",", "reMax", ",", "subd"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"imQuarters", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"imMin", ",", "imMax", ",", "subd"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Generate", " ", 
       SuperscriptBox["subd", "2"], " ", "subrectangles"}], "*)"}], 
     RowBox[{"subdividedRectangles", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"reQuarters", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+", 
             RowBox[{"I", " ", 
              RowBox[{"imQuarters", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"reQuarters", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "+", 
             RowBox[{"I", " ", 
              RowBox[{"imQuarters", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}]}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "subd"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "subd"}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Compute", " ", "winding", " ", "numbers", " ", "for", " ", "each", " ",
        "subrectangle"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"subdividedRectanglesWinding", "=", 
      RowBox[{"Parallelize", "[", 
       RowBox[{"ComputeWindingNumberRect", "@@@", "subdividedRectangles"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", " ", "rectangles", " ", "with", " ", "non"}], "-", 
        RowBox[{"zero", " ", "winding", " ", "numbers"}]}], ",", " ", 
       RowBox[{"set", " ", "some", " ", "reasonable", " ", "threshold"}]}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"selected", "=", 
      RowBox[{"Pick", "[", 
       RowBox[{"subdividedRectangles", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", ">", "0.3"}], "&"}], "/@", 
         "subdividedRectanglesWinding"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<selected rectangles: \>\"", ",", "selected"}], "]"}], ";", 
     "\[IndentingNewLine]", "selected"}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FindRectangles", "[", 
   RowBox[{"rectangle_", ",", "depth_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "rects", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"depth", ">=", "RecursionSteps"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"At", " ", "max", " ", "depth"}], ",", 
        RowBox[{"return", " ", "the", " ", "rectangle"}]}], "*)"}], 
      RowBox[{"{", "rectangle", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Subdivide", " ", "and", " ", "continue", " ", "recursively"}],
        "*)"}], 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{"\"\<entering depth: \>\"", ",", "depth"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rects", "=", 
        RowBox[{"SubdivideRect", "[", "rectangle", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"FindRectangles", "[", 
          RowBox[{"#", ",", 
           RowBox[{"depth", "+", "1"}]}], "]"}], "&"}], "/@", "rects"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RootsFromRectangles", "[", "rectangles_", "]"}], ":=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", "2"}], "&"}], ",", 
     "rectangles"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExtractCoordinates", "[", "list_", "]"}], ":=", 
  RowBox[{"Cases", "[", 
   RowBox[{"list", ",", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
